FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# OAuth *web* client ID from Firebase Console → Project settings → Your apps
# (or Google Cloud credentials). Required for Google sign-in / link.
FIREBASE_GOOGLE_WEB_CLIENT_ID=
# 1 = Auth emulator (email / Maestro). 0 or omit with real credentials = live Google/Apple.
FIREBASE_USE_AUTH_EMULATOR=1
# Required for live Google (FIREBASE_USE_AUTH_EMULATOR=0): must match the Firebase
# Android app package for FIREBASE_APP_ID. Empty → com.example.demo (emulator / Maestro).
# After changing: `make android-demo` or `make ios-demo` (writes gitignored Dioxus.toml
# from Dioxus.toml.example, then serves). Maestro reads the same var via
# `appId: ${ANDROID_APPLICATION_ID}` (`make maestro` passes -e).
ANDROID_APPLICATION_ID=
