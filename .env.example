FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# OAuth *web* client ID from Firebase Console → Project settings → Your apps
# (or Google Cloud credentials). Required for Google sign-in / link.
FIREBASE_GOOGLE_WEB_CLIENT_ID=
# 1 = Auth emulator (email / Maestro). 0 or omit with real credentials = live Google/Apple.
FIREBASE_USE_AUTH_EMULATOR=1
# Must match the Firebase Android app package for FIREBASE_APP_ID (live Google).
# Empty → com.example.demo. Run `make sync-bundle-id` (Dioxus.toml) after changing.
# Maestro reads the same var via `appId: ${ANDROID_APPLICATION_ID}` (`make maestro` passes -e).
ANDROID_APPLICATION_ID=
